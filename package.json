{
  "name": "@knowledgator/typescript-sdk",
  "version": "1.0.1",
  "description": "TypeScript client SDK for the Knowledgator API",
  "keywords": [
    "knowledgator",
    "sdk",
    "api",
    "client",
    "typescript",
    "nodejs"
  ],
  "homepage": "https://github.com/Knowledgator/knowledgator-sdk.js#readme",
  "bugs": {
    "url": "https://github.com/Knowledgator/knowledgator-sdk.js/issues"
  },
  "license": "MIT",
  "author": "Knowledgator <info@knowledgator.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Knowledgator/knowledgator-sdk.js.git"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json && shx mv dist/cjs/index.js dist/cjs/index.cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "dev": "tsx watch src/index.ts",
    "clean": "shx rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.base.json",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "lint-staged": "lint-staged",
    "test": "jest --testPathPattern=src/",
    "test:unit": "jest --testPathPattern=src/",
    "test:e2e": "jest --testPathPattern=tests/e2e/",
    "test:coverage": "jest --coverage --testPathPattern=src/",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "release": "release-it"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jiti": "^2.4.2",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "release-it": "^19.0.3",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "undici": "^7.11.0"
  },
  "dependencies": {
    "valibot": "^1.1.0"
  }
}
